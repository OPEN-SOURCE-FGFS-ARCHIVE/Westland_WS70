-->
<PropertyList>

 <sim include="Nasal/crewviews.xml">

  <description>Westland WS70 MP crew</description>
  <author>Anders Gidenstam</author>
  <status>alpha</status>
  <aircraft-version>$Id$</aircraft-version>
  
  <flight-model>null</flight-model>
  
  <previews>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>Splash/5.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/6.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/3.jpg</path>
	  </preview>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>Splash/4.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/1.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/2.jpg</path>
	  </preview>

	</previews>

  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>
  
  	<systems>
      <electrical>
        <path>Aircraft/Generic/generic-electrical.xml</path>
      </electrical>
 
	  
	   <autopilot n="102">
        <path>Systems/glass-rain.xml</path>
      </autopilot>
	  </systems>

  <!-- 3d model -->
  <model>
   <path>Aircraft/Westland_WS70/Models/WS-70-Crew.xml</path>
   <bo105>
    <hdr>false</hdr>
				<als>true</als>
				</bo105>
  </model>
<rendering>
    <refl_correction type="string">-0.51</refl_correction>
	<frensel-factor type="string">0.5</frensel-factor>
    </rendering>
 
 <sound>
      <path>Aircraft/Westland_WS70/Sounds/uh60-sound.xml</path>
    </sound>
 

  <menubar>
   <default>
    <menu n="100">
     <label>UH-60</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>

 </sim>
 
  <instrumentation>
    <adf>
                    <name>adf</name>
                    <number>0</number>
            </adf>
    
            <airspeed-indicator>
                    <name>airspeed-indicator</name>
                    <number>0</number>
                    <total-pressure>/systems/pitot/total-pressure-inhg</total-pressure>
                    <static-pressure>/systems/static/pressure-inhg</static-pressure>
            </airspeed-indicator>
    
            <altimeter>
                    <name>altimeter</name>
                    <number>0</number>
                    <static-pressure>/systems/static/pressure-inhg</static-pressure>
            </altimeter>
    
            <attitude-indicator>
                    <name>attitude-indicator</name>
                    <number>0</number>
                    <suction>/systems/vacuum/suction-inhg</suction>
            </attitude-indicator>
    
            <clock>
                    <name>clock</name>
                    <number>0</number>
            </clock>
    
            <dme>
                    <name>dme</name>
                    <number>0</number>
            </dme>
    
            <encoder>
                    <name>encoder</name>
                    <number>0</number>
                    <static-pressure>/systems/static/pressure-inhg</static-pressure>
            </encoder>
           
            <marker-beacon>
                    <name>marker-beacon</name>
                    <number>0</number>
            </marker-beacon>
    
            <heading-indicator>
                    <name>heading-indicator</name>
                    <number>0</number>
                    <suction>/systems/vacuum/suction-inhg</suction>
            </heading-indicator>
    
            <magnetic-compass>
                    <name>magnetic-compass</name>
                    <number>0</number>
            </magnetic-compass>
    
            <nav-radio>
                    <name>nav</name>
                    <number>0</number>
            </nav-radio>
    
            <nav-radio>
                    <name>nav</name>
                    <number>1</number>
            </nav-radio>
    
            <slip-skid-ball>
                    <name>slip-skid-ball</name>
                    <number>0</number>
            </slip-skid-ball>
    
            <turn-indicator>
                    <name>turn-indicator</name>
                    <number>0</number>
            </turn-indicator>
    
            <vertical-speed-indicator>
                    <name>vertical-speed-indicator</name>
                    <number>0</number>
                    <static-pressure>/systems/static/pressure-inhg</static-pressure>
            </vertical-speed-indicator>
            
            <radar>
                <name>wxradar</name>
                <number>0</number>
            </radar>
    
            <tacan>
                    <name>tacan</name>
                    <number>0</number>
            </tacan>
            
             <gsdi>
      <serviceable type="bool">true</serviceable>
      <enabled type="bool">true</enabled>
    </gsdi>
	 <illumination>
   <settings>
    <lcd-brightness-offset type="double">0.25</lcd-brightness-offset>
    <led-brightness-offset type="double">0.25</led-brightness-offset>
   </settings>
   <lcd-brightness type="double">0.75</lcd-brightness>
   <led-brightness type="double">0.75</led-brightness>
   <master-brightness type="double">0.74</master-brightness>
  </illumination>
  
  
  <rwr>
 <display-lighting-intens type="double">0.4</display-lighting-intens>
 <symbology-lighting-intens type="double">1</symbology-lighting-intens>
</rwr>

<enav><selected type="int">3</selected></enav>
 <radar>
  <range type="int" archive="y">40</range>
  <range-factor type="double" archive="n">0.001888</range-factor>
  <minimized type="bool" archive="y">false</minimized>
  <selected type="int">3</selected>

      <!-- inicio en pruebas -->
  <enabled type="bool">true</enabled>
  <az-field type="double">120</az-field>
  <range type="double">150</range>
  <range-selected type="double">50</range-selected>
  <radar2-range type="double">150</radar2-range>
  <display-rdr type="bool">true</display-rdr>
  <radar-standby type="int">3</radar-standby>
<mode>
  <rws type="bool">true</rws>
  <tws-auto type="bool">false</tws-auto>
</mode>

</radar> 


  <radar2>
   <sweep-width-m type="double">0.0844</sweep-width-m>
   <range-width-m type="double">0.0846</range-width-m>
   <radius-ppi-display-m type="double">0.0846</radius-ppi-display-m>
   <hud-eye-dist-m type="double">0.6705</hud-eye-dist-m>
   <hud-radius-m type="double">0.071</hud-radius-m>
  </radar2>

   <radar-awg-9>
	<ccm-mode-spl type="bool">false</ccm-mode-spl>
	<ccm-mode-alt-dhf type="bool">false</ccm-mode-alt-dhf>
	<ccm-mode-trs type="bool">false</ccm-mode-trs>
	<display-rdr type="bool">true</display-rdr>
	<display-ir type="bool">false</display-ir>
	<display-iff type="bool">false</display-iff>
	<mode type="string">PDS</mode> <!-- PDS, RWS, TWS, PDSTT, PSTT, VSL -->
	<ant-trk-light type="bool">false</ant-trk-light>
	<rd-rot-light type="bool">false</rd-rot-light>
	<jat-light type="bool">false</jat-light>
	<irot-light type="bool">false</irot-light>
	</radar-awg-9>
	
	
	 <efis>

			<ecam>
					<display-mode type="string">FUEL</display-mode>
			</ecam>
			<nd>
					<display-mode type="string">VOR</display-mode>
					<display-mode-knob type="int">2</display-mode-knob>
					<display-range type="int">10</display-range>
				
			</nd>
			<input>
				<vor-adf-1 type="int">1</vor-adf-1>
				<vor-adf-2 type="int">1</vor-adf-2>
				<CSTR type="bool">1</CSTR>
				<WPT type="bool">1</WPT>
				<VORD type="bool">1</VORD>
				<NDB type="bool">1</NDB>
				<ARPT type="bool">1</ARPT>
				<WX type="bool">1</WX>
				<TERR type="bool">1</TERR>
				<TRAF type="bool">1</TRAF>
				<taxi type="bool">1</taxi>
			</input>

		
		</efis>
  </instrumentation>


 <nasal>
  <rotorwash>
	<file>Aircraft/Westland_WS70/Nasal/rotorwash.nas</file>
	</rotorwash>
    <bo105>
	<file>Aircraft/Westland_WS70/Nasal/fcs.nas</file>
			<file>Aircraft/Westland_WS70/Nasal/casdisable.nas</file>
	
     
     <file>Aircraft/Westland_WS70/Nasal/sound-helper.nas</file>
	  <file>Aircraft/Westland_WS70/Nasal/liveries.nas</file>
		<file>Aircraft/Westland_WS70/Nasal/engines.nas</file>
	  <file>Aircraft/Westland_WS70/Nasal/bo105.nas</file>
	   <file>Aircraft/Westland_WS70/Nasal/vhf22.nas</file>
       <file>Aircraft/Westland_WS70/Nasal/vir32.nas</file>
        <file>Aircraft/Westland_WS70/Nasal/instruments.nas</file>
		  <file>Aircraft/Westland_WS70/Nasal/electrical.nas</file>
   </bo105>
   
     <dmesw>
                       <file>Aircraft/Westland_WS70/Nasal/dmesw.nas</file>
                </dmesw>
                <nav_scripts>
                        <file>Aircraft/Westland_WS70/Nasal/nav_scripts.nas</file>
                </nav_scripts>
 
   	<lights>
      <file>Aircraft/Westland_WS70/Nasal/Lights.nas</file>
    </lights>
	
 
   

 <dual_control_tools>
   <file>Aircraft/Generic/DualControl/dual-control-tools.nas</file>
  </dual_control_tools>
  <aircraft_dual_control>
   <file>Aircraft/Westland_WS70/Nasal/blackhawk-dual-control.nas</file>
  </aircraft_dual_control>
  <dual_control>
   <file>Aircraft/Generic/DualControl/copilot-dual-control.nas</file>
  </dual_control>
  </nasal>

</PropertyList>
